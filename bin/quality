#!/usr/bin/env bash
# Code quality guardrails for the work CLI — the Go counterpart to
# bin/quality, holding the one non-Ruby thing we ship to the same bar as
# core: complexity, duplication, dead code, unused dependencies, and a
# coverage floor. Run by CI (.github/workflows/test.yml) and locally before a release.
#
# Tools are fetched by `go run tool@version` rather than vendored: pinned
# so the gate cannot move under us, and installed nowhere on the machine.
set -euo pipefail

cli="$(cd "$(dirname "$0")/.." && pwd)"

STATICCHECK="honnef.co/go/tools/cmd/staticcheck@2026.2.1"
GOCYCLO="github.com/fzipp/gocyclo/cmd/gocyclo@v0.6.0"
DUPL="github.com/mibk/dupl@v1.0.0"

# Complexity ceiling. Deliberately generous, like .rubocop.yml's Metrics
# limits: it exists to catch runaway growth, not to force refactors. The
# three biggest functions today (run, parseGlobalFlags, runResource) sit
# at 17 — headroom for an argument-dispatch switch, not licence for one
# to double.
MAX_COMPLEXITY=20

# Coverage floor for the CLI, the counterpart to SimpleCov's 90 in
# test/test_helper.rb. Lower because the generated command table is data
# rather than behaviour: exercising every row would assert the generator's
# output twice (cli/generated_test.go already re-derives it from the spec).
MIN_COVERAGE=75

# Generated by bin/docs from docs/openapi.json — held to the contract test,
# not to the style gates. Its repeated per-resource literals are the point.
GENERATED='generated\.go'

failures=()

echo "== Vet =="
if go -C "$cli" vet ./...; then
  echo "Vet: no findings"
else
  failures+=("Vet: go vet reported findings.")
fi

echo
echo "== Format =="
unformatted="$(gofmt -l "$cli")"
if [ -z "$unformatted" ]; then
  echo "Format: gofmt clean"
else
  failures+=("Format: gofmt would rewrite:\n${unformatted}")
fi

echo
echo "== Static analysis =="
if go -C "$cli" run "$STATICCHECK" ./...; then
  echo "Static analysis: no findings (staticcheck — includes dead code, U1000)"
else
  failures+=("Static analysis: staticcheck reported findings.")
fi

echo
echo "== Complexity =="
complex="$(go -C "$cli" run "$GOCYCLO" -over "$MAX_COMPLEXITY" -ignore "$GENERATED" . || true)"
if [ -z "$complex" ]; then
  echo "Complexity: every function at or under $MAX_COMPLEXITY"
else
  failures+=("Complexity: function(s) over $MAX_COMPLEXITY:\n${complex}")
fi

echo
echo "== Duplication =="
# dupl takes files, not packages, and has no ignore flag — so the generated
# table is filtered out here rather than passed and excused.
handwritten=()
while IFS= read -r file; do handwritten+=("$file"); done < <(
  find "$cli" -maxdepth 1 -name '*.go' ! -name 'generated.go' | sort
)
clones="$(cd "$cli" && go run "$DUPL" -t 75 "${handwritten[@]}" 2>&1)"
if echo "$clones" | grep -q "Found total 0 clone groups"; then
  echo "Duplication: no clone groups over 75 tokens"
else
  failures+=("Duplication: copy-paste found. Extract the shared code:\n${clones}")
fi

echo
echo "== Unused dependencies =="
if go -C "$cli" mod tidy -diff; then
  echo "Unused dependencies: go.mod and go.sum are tidy"
else
  failures+=("Unused dependencies: go.mod/go.sum are not tidy. Run \`go mod tidy\`.")
fi

echo
echo "== Coverage =="
coverage_output="$(go -C "$cli" test -cover ./...)"
echo "$coverage_output"
coverage="$(echo "$coverage_output" | sed -n 's/.*coverage: \([0-9.]*\)% of statements.*/\1/p' | head -1)"
if [ -z "$coverage" ]; then
  failures+=("Coverage: could not read a coverage percentage from \`go test -cover\`.")
elif awk "BEGIN { exit !($coverage < $MIN_COVERAGE) }"; then
  failures+=("Coverage: ${coverage}% is below the ${MIN_COVERAGE}% minimum.")
else
  echo "Coverage: ${coverage}% (minimum ${MIN_COVERAGE}%)"
fi

if [ ${#failures[@]} -gt 0 ]; then
  echo
  for failure in "${failures[@]}"; do
    printf '%b\n\n' "$failure"
  done
  exit 1
fi

echo
echo "CLI quality checks passed."
